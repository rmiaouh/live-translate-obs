{
  "name": "live-translate-obs",
  "productName": "Live Translate for OBS",
  "version": "0.2.0",
  "description": "Realtime translated captions for OBS on Windows and macOS.",
  "author": "Live Translate for OBS contributors",
  "main": ".vite/build/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "npm run prepare:native && npm run prepare:overlay && electron-forge start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "package": "npm run prepare:native && npm run prepare:overlay && npm run prepare:notices && electron-forge package",
    "make": "npm run prepare:native && npm run prepare:overlay && npm run prepare:notices && electron-forge make",
    "prepare:overlay": "vite build --config vite.overlay.config.ts",
    "prepare:notices": "node scripts/generate-third-party-notices.mjs",
    "prepare:native": "node scripts/build-windows-helper.mjs",
    "postinstall": "npm run prepare:overlay"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "lucide-react": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@types/node": "^22.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.3.0",
    "eslint": "10.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7"
  }
}
